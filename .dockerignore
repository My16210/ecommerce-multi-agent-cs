# 构建上下文里不该出现的东西。
#
# 这个文件的核心职责只有一条：**挡住 .env**。
# 挡不住的话密钥会被 `COPY . /app` 烤进镜像层，而镜像层是可以被 `docker save`
# 导出、被推到 registry、被别人 pull 的——那是一次不可撤销的泄露。.gitignore
# 只管 git，管不到 docker build，所以这两件事必须各写一份。
#
# ═══════════════════════════════════════════════════════════════════════════
# ⚠️ 这里的 **`**/` 前缀不是啰嗦，是必须的：** .dockerignore 和 .gitignore
#    的匹配规则**不一样**。
#
#      .gitignore   ：不带 `/` 的模式**在任何层级**都匹配。
#                     `*.db` 能挡住 `data/knowledge/chat_history.db`。
#      .dockerignore：模式是对**整条相对路径**做 filepath.Match，而 `*`
#                     **不跨 `/`**。`*.db` 只能挡住根目录下的 `.db`。
#
#    这一点是真踩到的：最初照 .gitignore 的写法只写了 `*.db` / `*.sqlite` /
#    `__pycache__/`，构建照样成功，**构建日志里一句提示都没有**。是镜像建出来
#    之后 `find /app -name '*.db'` 才看见 chat_history.db（里面有对话记录）、
#    review_queue.db、orders.sqlite 和一堆 Windows 编的 .pyc 全都躺在镜像里。
#    要跨层级，必须显式写 `**/`。
# ═══════════════════════════════════════════════════════════════════════════

# ——— 密钥 ———
.env
.env.*
# 模板放行：它只有占位符，而且镜像里留着它，容器内排查时能对着看有哪些变量
!.env.example

# ——— 依赖与虚拟环境 ———
# .venv 由 builder 阶段单独 COPY 进去；这里的会被 `COPY . /app` 再盖一遍，
# 而且宿主上那份是 Windows 的（.exe、Scripts/），搬进 Linux 镜像只会变成垃圾。
.venv/
**/__pycache__/
**/*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# ——— 可重建的产物：别进镜像 ———
# 向量库是**索引**不是数据（数据是 documents/），13M 且能从语料重建；
# 而运行时会用 ./data 这个 bind mount 把它盖住，烤进镜像纯属白占体积。
data/knowledge/vector_store/
data/analytics/output/

# **/*. 这一族要跨层级（见上面那段）：
#   orders.sqlite       —— seed 造出来的订单库
#   review_queue.db     —— 人审队列，里面是历史提问
#   chat_history.db     —— **多轮对话记录**，这个尤其不该进镜像
#   *.db-wal 等         —— SQLite 的伴生文件，`*.db` 匹配不到它们
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-wal
**/*.db-shm
**/*.db-journal
logs/

# Milvus 三件套的数据卷（docker-compose 的 milvus profile 会建）
volumes/

# ——— 测试与开发工具：运行时用不到 ———
# tests/ 也挡掉：镜像里那份源码是为了"能跑"，不是为了"能改"。
tests/

# React 前端的依赖目录：平台相关、几十 MB，而且只在构建时需要。
# `frontend/dist/` **不挡**——它在宿主上构建好之后会进镜像，api.py 会挂到 /ui。
frontend/node_modules/

# ——— 别挡住这几类 ———
#   data/knowledge/documents/    语料本体（含「电商客服示例」）
#   data/knowledge/*.jsonl       评测集 / 金标准：镜像里带着，`answer_eval` 才跑得起来
#                                （虽然它们通常被 bind mount 盖住，但"不起卷也能跑"
#                                 这条得成立）
#   它们看着像产物，其实是资产的来源。

# ——— 仓库元数据与编辑器 ———
.git/
.gitignore
.idea/
.vscode/
.DS_Store
Thumbs.db

# Docker 自己的文件：它们只在构建时用，不进镜像
Dockerfile
docker-compose.yml
.dockerignore
