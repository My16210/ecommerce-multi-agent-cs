# ============================================================================
# 公网只读演示的配置模板
#
#     cp .env.prod.example .env.prod
#     # 填好下面这些，再按 docs/RUNBOOK.md 启动
#     chmod 600 .env.prod
#
# ⚠️ .env.prod 是**密钥文件**：不进仓库、不发聊天、不贴日志。
#    `docker compose config` 会把 env_file 的内容原样打印出来——贴之前先确认
#    手里那份不是它的输出。
#
# 这些值是"能跑起来的最小集合"，不是一份生产配置。真实上线还要身份、审计、
# 备份、监控——见 docs/上线清单.md 和 docs/RUNBOOK.md 的「这一层没做什么」。
# ============================================================================

# ——— 域名与证书 ———
# 域名的 A/AAAA 记录必须已经指向这台服务器，80/443 对公网可达。
DOMAIN=demo.example.com
# 证书到期提醒邮箱：**没有**对应的环境变量——Caddyfile 里没有 email 指令。
# 想收提醒就在 Caddyfile 的全局块里加一行 `email you@example.com`。

# ——— 演示闸门 ———
# docker-compose.prod.yml 里还会强制 APP_ENV=prod / DEMO_MODE=1，这里写出来是为了
# 让读文件的人知道现在是什么模式。
# APP_ENV=prod 会让进程在"既没开身份层、也没开演示"时拒绝启动；这份模板开了
# DEMO_MODE，所以能过闸。
APP_ENV=prod
DEMO_MODE=1

# 这一套由 Caddy 直接终止 TLS，限流默认取 TCP 对端地址即可，不要打开它。
# 只有再加一层自己控制的反向代理、并且需要按真实客户端 IP 限流时才设为 1；
# 没有可信代理时打开它，X-Forwarded-For 可以被客户端随意伪造。
# 这个编排里 app 只在 compose 内网、唯一入口是 Caddy，所以 compose 强制设为 1。
# 自己改编排时注意：只有确实在可信反代后面才能开，否则客户端可伪造 XFF。
# TRUST_PROXY_HEADERS=1

# 邀请码：进入界面要输的那串东西。**用下面这条命令生成，不要手编**：
#     python -c "import secrets; print(secrets.token_urlsafe(24))"
# 没配它时演示模式会拒绝所有人（fail closed），而不是放行所有人。
DEMO_INVITE_CODE=replace-with-a-long-random-string

# 每个客户端每分钟最多几次请求。它挡不住换 IP / NAT 出口，
# 真正的成本闸是下面那条预算。
DEMO_RATE_LIMIT_PER_MINUTE=12

# 每天所有请求加起来的 token 上限（in+out）。按实际用量记账，重启也算数。
# 20 万 token 大致是 qwen-plus 几块钱的量级；按自己的预算改。
DEMO_DAILY_TOKEN_BUDGET=200000

# ——— 模型与检索（必填）———
# 通义千问：路由、汇总、知识库生成。
QWEN_API_KEY=sk-xxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 硅基流动：embedding / rerank / 图片理解共用。
SILICONFLOW_API_KEY=sk-xxxx

# 图片理解默认复用 SILICONFLOW_API_KEY；要换供应商/模型再打开这几行。
# VISION_API_KEY=sk-xxxx
# VISION_BASE_URL=https://api.siliconflow.cn/v1
# VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# VISION_TIMEOUT=30
# VISION_MAX_IMAGE_MB=5

# DeepSeek 只在数据分析 worker 用；演示模式已经把它关掉，因此不需要配。

# ——— 数据与保留 ———
VECTOR_BACKEND=chroma

# 公网演示里会话里是陌生人的话，保留期比本地短。到期靠启动时清一次 +
# 外挂 cron（见 RUNBOOK）。
SESSION_TTL_DAYS=7
HISTORY_TURNS=4

# 关掉"把值得沉淀的提问写进待审核队列"。公网演示不该把用户的问题
# 悄悄攒成一个知识库审核队列。
ENABLE_QUESTION_REVIEW=false

# 预算账本的位置。默认在 data/orchestrator/demo_usage.sqlite（随 data/ 卷持久化）。
# DEMO_USAGE_DB_PATH=/app/data/orchestrator/demo_usage.sqlite
