# Caddy 反向代理：自动 HTTPS（Let's Encrypt / ZeroSSL）。
#
# DOMAIN 由 docker-compose.prod.yml 从 .env.prod 注入。
# 前置条件：域名的 A/AAAA 记录已经指向这台服务器，且 80/443 没有被别的东西占用。
# 证书申请失败时先查这两件事，再看 `docker compose logs caddy`。
#
# 刻意**没有**写 email 指令：它是可选的，而 Caddyfile 的 env 默认值写一个
# 假邮箱只会让 ACME 账号绑到一个不存在的地址。想收证书到期提醒就在
# `{ ... }` 全局块里自己加一行 `email you@example.com`。

{$DOMAIN} {
	encode zstd gzip

	# 限制 HTTP 请求体。Streamlit 的图片上传走 websocket frame，不受这条限制；
	# 应用自己的图片上限是 VISION_MAX_IMAGE_MB=5，所以 8MB 留了余量。
	# 没有这条时，一个超大表单可以先把内存/带宽吃掉再被应用拒绝。
	request_body {
		max_size 8MB
	}

	# Streamlit 的 websocket 和 /_stcore/health 都在这一个 upstream 上。
	# reverse_proxy 自动处理 Upgrade，不需要额外配置。
	reverse_proxy app:8501 {
		health_uri /_stcore/health
		health_interval 30s
		health_timeout 5s
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Streamlit 的页面里有内联脚本和样式，所以 script/style 必须留
		# 'unsafe-inline'；其余来源一律收紧到同源。connect-src 留 ws/wss
		# 给 Streamlit 自己的 websocket，worker-src 留 blob 给前端 worker。
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ws: wss:; worker-src 'self' blob:"
		# frame-ancestors 已经够新浏览器用；X-Frame-Options 照顾老浏览器。
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# 不把 Caddy 版本报给外面。
		-Server
	}

	log {
		output stdout
		format console
	}
}
