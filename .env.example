# 复制成 .env 再填真值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交——**密钥只放这里，不要写进代码或文档**。
#
# 合并前这里有 RAG_KB_ROOT / SALES_AGENT_ROOT / SALES_AGENT_PYTHON 三个变量，
# 用来告诉编排层"另外两个仓库在哪、用哪个解释器起它"。合并之后 sibling 就是
# 自己，那三个变量连同它们对应的代码一起删了——它们的存在本身就是"没合干净"
# 的标记。现在这个文件里**没有任何一条是"别人的东西在哪"**。

# ═══════════════════════════════════════════════════════════════
# 一、密钥与模型：全项目只有这一处
#
# 三个子系统各自有一份 settings，但密钥和模型名**只在这一个文件里读**
# （`ecom/settings.py` 是唯一 load_dotenv 的地方）。这不是整洁癖：
# 同一个 key 在两处配，迟早改了一处忘了另一处，而症状是"某个 worker 偶尔
# 403"——那种错查起来最费时间。
# ═══════════════════════════════════════════════════════════════

# ——— 通义千问（阿里云百炼 DashScope）———
# 控制台：https://bailian.console.aliyun.com/
# 用途：编排层的路由 + 汇总、知识库的答案生成、数据分析的审查节点。
QWEN_API_KEY=sk-xxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ——— 硅基流动（Embedding + Rerank 共用这一个 key）———
# 控制台：https://cloud.siliconflow.cn/account/ak
# 注意：账号需完成实名认证，否则 rerank 接口会返回 403
SILICONFLOW_API_KEY=sk-xxxx

# ——— 图片理解（多模态，默认复用上面的 SILICONFLOW key）———
# 图片先提取成结构化意图（订单号/金额/商品/诉求），再拼进对话；不直接喂主链路。
# 模型名会随平台上下架变化，跑不通时先看控制台的模型列表。下面几项都有默认值，
# 一般只需要保证 SILICONFLOW_API_KEY 是有效的。
# VISION_API_KEY=sk-xxxx
# VISION_BASE_URL=https://api.siliconflow.cn/v1
# VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct
# VISION_TIMEOUT=30
# VISION_MAX_IMAGE_MB=5

# ——— DeepSeek（数据分析子系统的主力模型）———
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ——— OpenAI（可选，一般不用）———
# 数据分析子系统支持三家模型，切换方式：
#   settings.get_llm_kwargs("deepseek" | "qwen" | "openai")
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 各家的采样温度（和模型名一样，归口在这里，不散落到各子系统）
# DEEPSEEK_TEMPERATURE=0.3
# QWEN_TEMPERATURE=0.3
# OPENAI_TEMPERATURE=0.3

# ═══════════════════════════════════════════════════════════════
# 二、知识库（ecom/knowledge）
# ═══════════════════════════════════════════════════════════════

# 向量库后端：chroma（默认，零外部依赖）或 milvus
# 选 milvus 前记得：uv sync --extra milvus，并把服务跑起来
VECTOR_BACKEND=chroma

# 仅 VECTOR_BACKEND=milvus 时生效
MILVUS_URI=http://localhost:19530
# 本地 Standalone 无鉴权，留空即可；连 Zilliz Cloud 才需要填
MILVUS_TOKEN=

# 是否把"模型判定值得沉淀的提问"写进待审核队列
# 关掉它只是不写队列，不影响问答本身
ENABLE_QUESTION_REVIEW=true

# ---- 混合检索（向量 + BM25）----
# 检索默认是"向量 + BM25 关键词"两路召回、RRF 融合。
# 把下面这行改成 false 就退回纯向量检索——这是做 A/B 对比、
# 以及怀疑 BM25 拖后腿时回退基线的开关。
# 对比方法：HYBRID_SEARCH=false uv run python -m ecom.knowledge.cli.answer_eval
HYBRID_SEARCH=true

# BM25 的两个超参（一般不用改）。k1 管词频饱和，b 管长度归一化。
# BM25_K1=1.5
# BM25_B=0.75

# RRF 的平滑常数、两路权重、两路各自的召回宽度（一般不用改）
# RRF_K=60
# 两路权重默认 1.0 = 等价融合，这本身就是调参结论：
# tune_rrf.py 在留出集上没调出稳定收益，保留这两个参数是为了让那个结论可复现。
# RRF_WEIGHT_VECTOR=1.0
# RRF_WEIGHT_BM25=1.0
# VECTOR_RECALL_K=20
# BM25_RECALL_K=20

# 问题级向量缓存条数（同一问题重复提问不再走 embedding 往返）。0 = 关闭
# 只缓存**逐字相同**的问题；语义缓存（相似就复用答案）明确不做，理由见 embedder.py
# QUERY_EMBED_CACHE_SIZE=256

# 联网搜索整条这一路的时间预算（秒），Tavily 与 ddgs 共用
# 超了就直接跳过联网结果，不让它拖住答案
# WEB_SEARCH_TIMEOUT=8

# 可选：配了就优先用 Tavily 联网搜索，不配则用免 key 的 ddgs
# 注意：光配 key 不装包不生效，会自动退回 ddgs。要装：uv sync --extra search
# TAVILY_API_KEY=tvly-xxxx

# 成本估算单价（元/百万 tokens），只给 profile.py 的账单表用。
# 这几个数官方会调，所以放配置里而不是抄进文档——只有一处会过期。
# QWEN_PRICE_INPUT=0.8
# QWEN_PRICE_OUTPUT=2.0

# 评测集里"谁标的"这一列（gold_set.py / answer_eval.py 用）。
# 不填就退回 git user.name。只在多人协作标注时需要显式指定。
# GOLD_LABELER=

# ═══════════════════════════════════════════════════════════════
# 三、订单库（ecom/orchestrator/db）
# ═══════════════════════════════════════════════════════════════

# 不填 → 用 SQLite，clone 下来就能跑。
# 填了 → 走 MySQL（需要 uv sync --extra mysql），schema 是同一份。
# 注意本机 docker 里的 mysql8 发布在 **3308**（不是 3306），默认值不跟着某台机器走。
# ORDER_DB_PATH=data/orders.sqlite
# ORDER_DB_DSN=mysql://root:password@127.0.0.1:3308/ecom_cs

# 数据分析子系统接 MySQL 时用的连接参数（可选，走 ORDER_DB_DSN 时不需要）
# MYSQL_HOST=localhost
# MYSQL_PORT=3308
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=ecom_cs

# --- 会话存储（多轮记忆，ecom/orchestrator/session.py）---
# 和订单库**分开一个文件**：两者的生命周期不一样——订单库是"灌一次就不动"的
# 派生数据，会话是"每天都在长"的运行数据。
# SESSION_DB_PATH=data/orchestrator/sessions.db

# 会话保留多少天。到期由 `python -m ecom.orchestrator.cli.session purge` 清理，
# 界面的接口进程启动时也会顺手清一次。
#
# 为什么要有这个天数：会话 id 本身就是凭证（客户身份是从话里猜的、未认证的），
# **无主数据不该无限期留着**。这不是"顺手加个参数"，是合规问题的最小答案。
# SESSION_TTL_DAYS=30

# 每次喂给模型的历史轮数。和上面的保留期是**两件事**，别合并：
# 这个管"花多少 token"（成本），上面那个管"留多久"（合规）。
# HISTORY_TURNS=6

# --- 会话内长期记忆（ecom/orchestrator/memory.py）---
# 滑出上面那个窗口的消息会被压成摘要存进 memories 表，需要时按语义召回几条。
#
# 一轮最多带几条记忆进 prompt。它和 HISTORY_TURNS 同属成本，但**是两条独立通道**
# （原文精确但贵、摘要便宜但有损），所以刻意不给它们一个共同的倍率。
# 池子为空时一次 embedding 都不调——没有记忆的会话在这条路上是零开销。
# MEMORY_TOP_K=3

# 一次蒸馏最多把多少条消息喂给模型。长会话第一次蒸馏会把**全部**滑出窗口的消息
# 一次性塞进去，这个上限就是给那种情况兜底的。
# MEMORY_DISTILL_MAX_MESSAGES=40
#
# 注意：蒸馏**不在问答路径上**，只在 `python -m ecom.orchestrator.cli.memory distill`
# 里跑（所以记忆不是实时的，要外挂 cron）。上面两个值不会影响"每问一句花多少钱"。

# ═══════════════════════════════════════════════════════════════
# 四、编排层运行参数（都有合理默认，一般不用改）
# ═══════════════════════════════════════════════════════════════

# MAX_ROUNDS=2
# MAX_QUESTION_CHARS=2000

# 三个 worker 各自的时间预算（秒）。分开设是因为它们贵贱差一个数量级：
# 查订单是本地 SQLite 毫秒级，数据分析要跑模型生成的代码、还要出图。
# WORKER_TIMEOUT_KNOWLEDGE=90
# WORKER_TIMEOUT_ORDER=20
# WORKER_TIMEOUT_ANALYTICS=180
# WORKER_TIMEOUT_DEFAULT=60

# ROUTER_TEMPERATURE=0
# SYNTH_TEMPERATURE=0.3

# 路由的两次超时是一对，别只改一个：单次 8 秒、总预算 20 秒。两个都要有——
# 重试次数不封顶时间，只留次数的话"模型这条路不通"会拖到次数用完为止。
# （客户端（openai SDK）自带的重试已经在 ecom/orchestrator/utils/llm.py 关掉了：
#   两层重试是乘法关系，实测把一次本该 8 秒放弃的路由拖成了 25 秒。）
# ROUTER_TIMEOUT=8
# ROUTER_BUDGET=20
# ROUTER_ATTEMPTS=3

# SYNTH_TIMEOUT=60

# ═══════════════════════════════════════════════════════════════
# 五、两个鉴权开关（**默认方向故意相反，不是不一致**）
# ═══════════════════════════════════════════════════════════════

# HTTP 接口（api.py）的密钥，走 X-API-Key 头。
# **不配就放行**——api 以读为主，面向"clone 下来就能 curl 一下"。
# 不配时启动会打一条 WARNING，把"这个服务是裸的"明说出来，而不是静静地不管。
#
# ⚠️ 值必须是 ASCII。HTTP 头只能装 ASCII，非 ASCII 的 key **任何客户端都发不出来**
#    （httpx 会直接抛 UnicodeEncodeError），结果是"配了等于没配"、每个请求都 401。
#    配了非 ASCII 时会有一条 import 期的 WARNING 提醒。
#
# 注意别和上面的模型 Key 混：README 里"不填 Key 也能跑"说的是**模型**的 Key
# （路由会退回关键词规则），和这个开不开鉴权是两码事。
# API_KEY=

# 后台管理端（admin.py）的口令。
# **不配就拒绝启动**（st.error + st.stop）——它能批准退货，是对花钱的操作下结论。
# 一句话：**读可以默认开放，写必须默认关闭。**
#
# ⚠️ 这是**演示级的鉴权**：一个明文口令，没有用户、没有角色、没有审计
#    （"审核人"是界面上手填的一个字符串，填不填都行）。它挡住的是"随手扫到
#    这个端口的人"，别把它说成"做了权限系统"。
#    第二层是端口绑定：compose 里 admin 服务只发布到 127.0.0.1（见 docker-compose.yml）。
# ADMIN_PASSWORD=改成你自己的口令

# ——— 身份层（可选；对外提供 API / 后台时建议打开）———
# 打开后：
#   · /chat、/chat/stream 需要 `Authorization: Bearer <token>`；
#   · /trace 需要 admin 角色；
#   · 会话按 principal 归属，别人的 session_id 一律 404；
#   · admin.py 改用 admin token 登录，审核人自动取 principal.name。
# 关闭时退回旧语义：API_KEY（不配就放行）+ ADMIN_PASSWORD。
#
# 创建 principal（token 只显示一次，服务端只存 SHA-256）：
#   python -m ecom.auth.cli create --name alice --role admin [--ttl-days 30] [--customer C20755]
#   python -m ecom.auth.cli set-password alice
#   python -m ecom.auth.cli set-customer alice C20755   # 绑定客户号，订单不再靠猜
#   python -m ecom.auth.cli rotate alice [--ttl-days 30]
#   python -m ecom.auth.cli list
#   python -m ecom.auth.cli revoke alice
#   python -m ecom.auth.cli purge-sessions
#   python -m ecom.auth.cli audit --limit 20
#
# 登录会话有效期（小时）；/auth/login 用用户名 + 密码换短期 token。
# AUTH_SESSION_TTL_HOURS=12
# AUTH_ENABLED=1
# AUTH_DB_PATH=data/orchestrator/auth.db

# ═══════════════════════════════════════════════════════════════
# 六、公网演示模式（L1，默认关闭）
# ═══════════════════════════════════════════════════════════════
# 本地跑、CI 跑都不要打开。要挂到公网上看，用 **.env.prod** 和
# docker-compose.prod.yml，模板见 .env.prod.example。这里只列变量名，
# 具体取值和理由写在那个模板里：
#
#   DEMO_MODE=1                        打开只读演示（数据分析、退货申请、后台都关）
#   DEMO_INVITE_CODE=<随机串>           进界面/调 API 需要的邀请码；不配则拒绝所有人
#   DEMO_RATE_LIMIT_PER_MINUTE=12      每个客户端每分钟请求数
#   DEMO_DAILY_TOKEN_BUDGET=200000     每天 token 上限（按天落盘记账，重启也算数）
#   DEMO_USAGE_DB_PATH=data/orchestrator/demo_usage.sqlite
#
# 它们生效的位置：ecom/demo.py（规则）、core/router.py（不路由到 analytics）、
# workers/order.py（不落库写操作）、app.py / api.py（邀请码、限流、预算）。
# **只读不是靠界面藏按钮**：API 和 CLI 也走同一套闸。

# ═══════════════════════════════════════════════════════════════
# 七、MCP 工具服务（ecom/mcp，默认只读）
# ═══════════════════════════════════════════════════════════════
# 启动：uv run python -m ecom.mcp.server（stdio，由客户端拉起）
# 查看当前开放的工具：uv run python -m ecom.mcp.server --list-tools
#
# 默认只注册三个只读工具：get_order / get_order_returns / search_knowledge。
# 下面两个开关**默认关着**，因为它们把"按客户号查 PII"和"写库"交给了外部 Agent：
#   MCP_ENABLE_PII=1       注册 list_customer_orders（按客户号查订单）
#   MCP_ENABLE_WRITES=1    注册 create_return（提交待审核退货申请）
#
# 写操作即使打开也还要调用方显式传 confirm=true；演示模式（DEMO_MODE=1）下
# 无论如何都拒绝落库。两个开关是**两把独立的钥匙**，不是同一个开关的两档。
# MCP_ENABLE_WRITES=0
# MCP_ENABLE_PII=0
# MCP_MAX_QUERY_CHARS=500
# MCP_MAX_TOP_K=5
# MCP_MAX_CUSTOMER_ORDERS=20

# ═══════════════════════════════════════════════════════════════
# 八、compose 的端口（这几条由 docker compose 读，应用本身不看）
# ═══════════════════════════════════════════════════════════════

# 端口被占了就改。也可以临时传：APP_PORT=8600 docker compose up -d
# APP_PORT=8501
# ADMIN_PORT=8502

# 客户界面发布到哪个网卡。**默认 127.0.0.1 = 只有本机能连**。
#
# 为什么默认收着：这个界面**没有任何鉴权**，而它能触发一次数据分析——也就是
# 让模型生成的 Python 跑起来（沙箱不是强隔离，见 docs/上线清单.md）。只写
# "8501:8501" 等于绑所有网卡，同局域网里任何人都能打开它。
# 用 localhost 访问不受任何影响（那本来就是回环地址）。真要跨机器演示再放开：
# APP_BIND=0.0.0.0
