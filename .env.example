# 复制成 .env 再填真值：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交——**密钥只放这里，不要写进代码或文档**。
#
# 合并前这里有 RAG_KB_ROOT / SALES_AGENT_ROOT / SALES_AGENT_PYTHON 三个变量，
# 用来告诉编排层"另外两个仓库在哪、用哪个解释器起它"。合并之后 sibling 就是
# 自己，那三个变量连同它们对应的代码一起删了——它们的存在本身就是"没合干净"
# 的标记。现在这个文件里**没有任何一条是"别人的东西在哪"**。

# ═══════════════════════════════════════════════════════════════
# 一、密钥与模型：全项目只有这一处
#
# 三个子系统各自有一份 settings，但密钥和模型名**只在这一个文件里读**
# （`ecom/settings.py` 是唯一 load_dotenv 的地方）。这不是整洁癖：
# 同一个 key 在两处配，迟早改了一处忘了另一处，而症状是"某个 worker 偶尔
# 403"——那种错查起来最费时间。
# ═══════════════════════════════════════════════════════════════

# ——— 通义千问（阿里云百炼 DashScope）———
# 控制台：https://bailian.console.aliyun.com/
# 用途：编排层的路由 + 汇总、知识库的答案生成、数据分析的审查节点。
QWEN_API_KEY=sk-xxxx
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ——— 硅基流动（Embedding + Rerank 共用这一个 key）———
# 控制台：https://cloud.siliconflow.cn/account/ak
# 注意：账号需完成实名认证，否则 rerank 接口会返回 403
SILICONFLOW_API_KEY=sk-xxxx

# ——— DeepSeek（数据分析子系统的主力模型）———
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ——— OpenAI（可选，一般不用）———
# 数据分析子系统支持三家模型，切换方式：
#   settings.get_llm_kwargs("deepseek" | "qwen" | "openai")
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# 各家的采样温度（和模型名一样，归口在这里，不散落到各子系统）
# DEEPSEEK_TEMPERATURE=0.3
# QWEN_TEMPERATURE=0.3
# OPENAI_TEMPERATURE=0.3

# ═══════════════════════════════════════════════════════════════
# 二、知识库（ecom/knowledge）
# ═══════════════════════════════════════════════════════════════

# 向量库后端：chroma（默认，零外部依赖）或 milvus
# 选 milvus 前记得：uv sync --extra milvus，并把服务跑起来
VECTOR_BACKEND=chroma

# 仅 VECTOR_BACKEND=milvus 时生效
MILVUS_URI=http://localhost:19530
# 本地 Standalone 无鉴权，留空即可；连 Zilliz Cloud 才需要填
MILVUS_TOKEN=

# 是否把"模型判定值得沉淀的提问"写进待审核队列
# 关掉它只是不写队列，不影响问答本身
ENABLE_QUESTION_REVIEW=true

# ---- 混合检索（向量 + BM25）----
# 检索默认是"向量 + BM25 关键词"两路召回、RRF 融合。
# 把下面这行改成 false 就退回纯向量检索——这是做 A/B 对比、
# 以及怀疑 BM25 拖后腿时回退基线的开关。
# 对比方法：HYBRID_SEARCH=false uv run python -m ecom.knowledge.cli.answer_eval
HYBRID_SEARCH=true

# BM25 的两个超参（一般不用改）。k1 管词频饱和，b 管长度归一化。
# BM25_K1=1.5
# BM25_B=0.75

# RRF 的平滑常数、两路权重、两路各自的召回宽度（一般不用改）
# RRF_K=60
# 两路权重默认 1.0 = 等价融合，这本身就是调参结论：
# tune_rrf.py 在留出集上没调出稳定收益，保留这两个参数是为了让那个结论可复现。
# RRF_WEIGHT_VECTOR=1.0
# RRF_WEIGHT_BM25=1.0
# VECTOR_RECALL_K=20
# BM25_RECALL_K=20

# 问题级向量缓存条数（同一问题重复提问不再走 embedding 往返）。0 = 关闭
# 只缓存**逐字相同**的问题；语义缓存（相似就复用答案）明确不做，理由见 embedder.py
# QUERY_EMBED_CACHE_SIZE=256

# 联网搜索整条这一路的时间预算（秒），Tavily 与 ddgs 共用
# 超了就直接跳过联网结果，不让它拖住答案
# WEB_SEARCH_TIMEOUT=8

# 可选：配了就优先用 Tavily 联网搜索，不配则用免 key 的 ddgs
# 注意：光配 key 不装包不生效，会自动退回 ddgs。要装：uv sync --extra search
# TAVILY_API_KEY=tvly-xxxx

# 成本估算单价（元/百万 tokens），只给 profile.py 的账单表用。
# 这几个数官方会调，所以放配置里而不是抄进文档——只有一处会过期。
# QWEN_PRICE_INPUT=0.8
# QWEN_PRICE_OUTPUT=2.0

# 评测集里"谁标的"这一列（gold_set.py / answer_eval.py 用）。
# 不填就退回 git user.name。只在多人协作标注时需要显式指定。
# GOLD_LABELER=

# ═══════════════════════════════════════════════════════════════
# 三、订单库（ecom/orchestrator/db）
# ═══════════════════════════════════════════════════════════════

# 不填 → 用 SQLite，clone 下来就能跑。
# 填了 → 走 MySQL（需要 uv sync --extra mysql），schema 是同一份。
# 注意本机 docker 里的 mysql8 发布在 **3308**（不是 3306），默认值不跟着某台机器走。
# ORDER_DB_PATH=data/orders.sqlite
# ORDER_DB_DSN=mysql://root:password@127.0.0.1:3308/ecom_cs

# 数据分析子系统接 MySQL 时用的连接参数（可选，走 ORDER_DB_DSN 时不需要）
# MYSQL_HOST=localhost
# MYSQL_PORT=3308
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=ecom_cs

# ═══════════════════════════════════════════════════════════════
# 四、编排层运行参数（都有合理默认，一般不用改）
# ═══════════════════════════════════════════════════════════════

# MAX_ROUNDS=2
# MAX_QUESTION_CHARS=2000

# 三个 worker 各自的时间预算（秒）。分开设是因为它们贵贱差一个数量级：
# 查订单是本地 SQLite 毫秒级，数据分析要跑模型生成的代码、还要出图。
# WORKER_TIMEOUT_KNOWLEDGE=90
# WORKER_TIMEOUT_ORDER=20
# WORKER_TIMEOUT_ANALYTICS=180
# WORKER_TIMEOUT_DEFAULT=60

# ROUTER_TEMPERATURE=0
# SYNTH_TEMPERATURE=0.3

# 路由的两次超时是一对，别只改一个：单次 8 秒、总预算 20 秒。两个都要有——
# 重试次数不封顶时间，只留次数的话"模型这条路不通"会拖到次数用完为止。
# （客户端（openai SDK）自带的重试已经在 ecom/orchestrator/utils/llm.py 关掉了：
#   两层重试是乘法关系，实测把一次本该 8 秒放弃的路由拖成了 25 秒。）
# ROUTER_TIMEOUT=8
# ROUTER_BUDGET=20
# ROUTER_ATTEMPTS=3

# SYNTH_TIMEOUT=60
